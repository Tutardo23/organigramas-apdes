{
  "name": "organigramas-apdes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src prisma scripts prisma.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/*.test.ts",
    "check": "npm run guard:hito && npm run guard:active-stack && npm run typecheck && npm run lint:new && npm run lint:core && npm run lint:editor-data && npm run lint && npm run test && npm run build",
    "audit:high": "npm audit --audit-level=high",
    "db:seed": "tsx prisma/seed.ts",
    "lint:new": "eslint \"src/components/organigramas/PucaraOrgChart.tsx\" \"src/app/organigramas/[schoolSlug]/pucara/actions.ts\" \"src/lib/buen-ayre-simple-hierarchy.ts\" --max-warnings=0",
    "lint:core": "eslint \"prisma/seed.ts\" \"src/app/organigramas/actions.ts\" \"src/app/organigramas/[schoolSlug]/page.tsx\" \"src/app/talento/page.tsx\" \"src/app/talento/[schoolSlug]/page.tsx\" \"src/app/talento/[schoolSlug]/actions.ts\" --max-warnings=0",
    "lint:editor-data": "eslint \"src/app/organigramas/[schoolSlug]/editar/actions.ts\" \"src/app/organigramas/[schoolSlug]/explorar/page.tsx\" --max-warnings=0",
    "guard:hito": "node scripts/check-hito-route.mjs",
    "guard:active-stack": "node scripts/check-active-orgchart-stack.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.14",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "dotenv": "^17.4.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
